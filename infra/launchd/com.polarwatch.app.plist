<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polarwatch.app</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/turph/Projects/polarWatch/infra/launchd/run-polarwatch.sh</string>
    </array>

