# Copy this file to data/secrets.env (gitignored — never commit real values)
# and fill in the credentials from https://admin.polaraccesslink.com

POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=

# Must exactly match the "Authorization redirect URL" registered for this
# client in the Polar portal.
POLAR_REDIRECT_URI=https://mini.tail5ef0b2.ts.net/polarwatch/api/auth/callback

# From https://www.strava.com/settings/api — Authorization Callback Domain
# there must be exactly "mini.tail5ef0b2.ts.net" (domain only, no path).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://mini.tail5ef0b2.ts.net/polarwatch/api/strava/auth/callback
